# Backend Environment Configuration Template

# Database Connection (PostgreSQL or SQLite for local dev)
# Local PostgreSQL: postgresql+psycopg://user:password@localhost:5432/secure_rag
# Local SQLite fallback: sqlite:///./secure_rag.db
DATABASE_URL=postgresql+psycopg://jahnavigajjala@localhost:5432/secure_rag

# Gemini API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# JWT Security Credentials
JWT_SECRET_KEY=secure_rag_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Administrator Registration Access Key
ADMIN_SIGNUP_KEY=secure_rag_admin_invite_2026
ADMIN_INVITATION_CODE=secure_rag_admin_invite_2026

# CORS Security (Comma-separated list of allowed origins, or * for dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
